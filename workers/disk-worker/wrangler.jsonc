{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "webvm-disk-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-01",
	"assets": {
		"directory": "./assets",
		"binding": "ASSETS",
		// Only disk endpoints go through the Worker. Everything else (the WebVM
		// frontend, disk chunk files) is served directly from static assets,
		// which is free and does not consume Worker subrequest budget.
		"run_worker_first": ["/*.ext2", "/debug/*"]
	},
	"durable_objects": {
		"bindings": [
			{ "name": "DISK_SESSIONS", "class_name": "DiskSession" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["DiskSession"] }
	],
	"vars": {
		"MAX_RANGE_BYTES": "8388608",
		// Unauthenticated test/inspection endpoints under /debug/*. Set to "0"
		// (or remove) for production deployments.
		"DEBUG_ENDPOINTS": "1"
	},
	"observability": {
		"enabled": true
	}
}
